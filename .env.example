# CyraSoul Multi-Agent Content Generation - Environment Variables

# Anthropic API Key (required)
ANTHROPIC_API_KEY=sk-ant-api03-...

# Voyage AI API Key for embeddings (required)
VOYAGE_API_KEY=pa-...

# Qdrant Configuration
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_API_KEY=  # Leave empty for local, set for Qdrant Cloud

# Shopify Configuration
SHOPIFY_STORE_URL=cyrasoul.myshopify.com
SHOPIFY_ACCESS_TOKEN=shpat_...
SHOPIFY_BLOG_ID=  # ID of the blog to post to

# Optional: Model override
# DEFAULT_MODEL=claude-sonnet-4-20250514

# Logging
LOG_LEVEL=INFO
