# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# Environment variables (contains API keys)
.env

# macOS
.DS_Store

# Qdrant data (can be regenerated)
qdrant_storage/

# Output files (generated content, but keep .gitkeep)
output/articles/*
!output/articles/.gitkeep
output/json/*
!output/json/.gitkeep
output/logs/*
!output/logs/.gitkeep

# Ralph session files (large, can be regenerated)
# Note: .ralph/ directory IS tracked - it contains important state
# .ralph/activity.log can get large, exclude if needed
# .ralph/activity.log

# IDE
.vscode/
.idea/

# Claude
.claude/
